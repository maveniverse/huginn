<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>eu.maveniverse.maven.parent</groupId>
    <artifactId>parent</artifactId>
    <version>64</version>
  </parent>

  <groupId>eu.maveniverse.maven.mcp</groupId>
  <artifactId>maven-mcp</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <name>${project.groupId}:${project.artifactId}</name>
  <description>Project-aware MCP server for Maven builds, for coding agents.</description>
  <url>https://www.maveniverse.eu/maven-mcp</url>

  <licenses>
    <license>
      <name>EPL-2.0</name>
      <url>https://www.eclipse.org/legal/epl-2.0/</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:git@github.com:maveniverse/maven-mcp.git</connection>
    <developerConnection>scm:git:git@github.com:maveniverse/maven-mcp.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/maveniverse/maven-mcp</url>
  </scm>

  <issueManagement>
    <system>Github</system>
    <url>https://github.com/maveniverse/maven-mcp/issues</url>
  </issueManagement>

  <ciManagement>
    <system>Github</system>
    <url>https://github.com/maveniverse/maven-mcp/actions</url>
  </ciManagement>

  <properties>
    <project.build.outputTimestamp>2026-10-21T22:00:00Z</project.build.outputTimestamp>
    <!-- Run time: Java 17, like Toolbox. -->
    <maven.compiler.release>17</maven.compiler.release>

    <version.toolbox>0.16.0</version.toolbox>
    <version.mima>2.4.48</version.mima>
    <version.resolver>1.9.27</version.resolver>
    <version.maven>3.9.16</version.maven>

    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.version>3.40.1.1</quarkus.platform.version>
    <quarkus.mcp-server.version>1.13.2</quarkus.mcp-server.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkiverse.mcp</groupId>
        <artifactId>quarkus-mcp-server-bom</artifactId>
        <version>${quarkus.mcp-server.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Same exclusions as toolbox:mcp: no CLI, no embedded Maven runtime. -->
    <dependency>
      <groupId>eu.maveniverse.maven.toolbox</groupId>
      <artifactId>shared</artifactId>
      <version>${version.toolbox}</version>
      <exclusions>
        <exclusion>
          <groupId>info.picocli</groupId>
          <artifactId>*</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.jline</groupId>
          <artifactId>jansi-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>eu.maveniverse.maven.mima.runtime</groupId>
          <artifactId>embedded-maven</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>jcl-over-slf4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>eu.maveniverse.maven.mima.runtime</groupId>
      <artifactId>standalone-static</artifactId>
      <version>${version.mima}</version>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>jcl-over-slf4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>io.quarkiverse.mcp</groupId>
      <artifactId>quarkus-mcp-server-stdio</artifactId>
    </dependency>

    <!-- Plain JUnit 5 unit tests; quarkus-junit brings Jupiter with the BOM's version. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
